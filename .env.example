# Copy to .env for reference; Render sets these in the dashboard / render.yaml.
# All are optional: the defaults below are used when a variable is missing.

# --- Server ---
PORT=3000                     # Render sets this automatically
HOST=0.0.0.0                  # must stay 0.0.0.0 on Render
NODE_ENV=development          # "production" on Render
ALLOWED_ORIGIN=               # the static site's URL, e.g. https://avalon.onrender.com (comma-separate several)
SERVE_CLIENT=                 # "true" to serve public/ from Express; default: on in dev, off in production

# --- Timings (decisions in CLAUDE.md) ---
SEAT_HOLD_MINUTES=5           # a disconnected player's seat is kept this long
HOST_GRACE_SECONDS=60         # an away host hands the crown to the longest-seated player after this
HOST_END_AFTER_MINUTES=2      # waiting this long on an offline player, the host is offered "End game"
ROOM_IDLE_MINUTES=120         # rooms with no activity are closed
REVEAL_FALLBACK_SECONDS=20    # vote/quest reveals move on even if someone's phone is idle
CONNECTION_LOST_SECONDS=30    # the client shows "Connection lost" after this
PICKS_THROTTLE_MS=150         # the leader's live picks are broadcast at most this often
SWEEP_SECONDS=60              # how often idle rooms are looked for

# --- Abuse limits ---
MAX_ROOMS=500                 # open rooms at once; creating more is refused
MAX_PAYLOAD_BYTES=4096        # largest socket message accepted
RATE_LIMIT_PER_SECOND=10      # events per socket per second (sustained)
RATE_LIMIT_BURST=20           # events per socket allowed in a burst

# --- Optional persistence (milestone 7) ---
REDIS_URL=                    # if set, rooms survive restarts; if empty, rooms live in memory
